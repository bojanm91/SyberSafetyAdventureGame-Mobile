{
  "expo": {
    "name": "CyberSafe Akademija",
    "slug": "csag-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "csag",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/app_icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#050816"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.csag.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app_icon_foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.csag.mobile"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed18f354-8391-4fba-98da-79e8e991eed8"
      }
    }
  }
}
